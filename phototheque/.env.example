# =============================================================================
# Photothèque — Croix-Rouge française, UL Boulogne-Billancourt
# Copiez ce fichier en `.env` puis renseignez les valeurs.
# =============================================================================

# --- Base de données PostgreSQL ---------------------------------------------
DATABASE_URL="postgresql://photo:photo@localhost:5432/phototheque?schema=public"

# --- Authentification ---------------------------------------------------------
# Secret de signature des sessions (JWT). Générer : openssl rand -base64 48
AUTH_SECRET="change-me-with-a-long-random-string"

# Mots de passe globaux. Ils ne sont JAMAIS envoyés au navigateur.
# Option A : en clair (secret serveur, ex. variable chiffrée Vercel)
USER_PASSWORD="9205"
ADMIN_PASSWORD="Com9205*"
# Option B (recommandée) : empreintes bcrypt, prioritaires si définies.
# Générer : node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'MonMotDePasse'
# USER_PASSWORD_HASH=""
# ADMIN_PASSWORD_HASH=""

# Cookie « Secure » (HTTPS). Par défaut : activé en production.
# COOKIE_SECURE=true

# Durée de session (en heures). Défaut : 168 (7 jours) pour USER, 12 pour ADMIN.
# SESSION_HOURS_USER=168
# SESSION_HOURS_ADMIN=12

# --- Stockage des fichiers -----------------------------------------------------
# "local" : disque du serveur (développement, VPS, Docker avec volume persistant)
# "s3"    : stockage objet compatible S3 (AWS S3, Scaleway, OVH, Cloudflare R2, MinIO...)
STORAGE_DRIVER="local"

# Driver local : dossier racine (créé automatiquement)
LOCAL_STORAGE_DIR="./storage"

# Driver S3
# S3_BUCKET="phototheque-crf"
# S3_REGION="fr-par"
# S3_ENDPOINT="https://s3.fr-par.scw.cloud"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

# --- Importation ---------------------------------------------------------------
# Taille maximale d'un fichier (Mo). Défaut 4096 (4 Go).
# MAX_UPLOAD_SIZE_MB=4096

# Fuseau horaire utilisé pour les statistiques et filtres de date
APP_TIMEZONE="Europe/Paris"
