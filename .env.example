# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/linkforge?schema=public"

# --- Redis (Upstash REST — compatible Edge Runtime) ---
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# --- Authentification ---
# Secret utilisé pour signer les JWT de session (openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# --- Sécurité interne ---
# Secret partagé entre la route Edge de redirection et les routes API internes
# (/api/internal/*). Générez une valeur aléatoire (openssl rand -hex 32).
INTERNAL_API_SECRET="change-me-in-production"

# Sel utilisé pour hasher les IP avant stockage (anonymisation RGPD).
IP_HASH_SALT="change-me-in-production"

# --- Application ---
# URL publique complète de l'application (utilisée pour construire les liens
# courts et les appels internes serveur-à-serveur).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
